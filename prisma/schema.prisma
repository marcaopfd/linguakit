generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id        String   @id @default(cuid())
  name      String
  /// Null for students created by the placement test before self-signup existed.
  email     String?  @unique
  /// scrypt hash; null means this student has no account and reaches the course
  /// only through their /learn/<id> link.
  password  String?
  /// Chosen at signup. Students created by the test carry it on testResult
  /// instead, so read it with `student.course ?? student.testResult?.course`.
  course    String?
  /// Explicit newsletter consent, with the moment it was given.
  newsletter   Boolean   @default(false)
  newsletterAt DateTime?
  createdAt DateTime @default(now())

  testResult TestResult?
  lessons    StudentLesson[]
  attempts   ExerciseAttempt[]
  reviews    ReviewItem[]
}

model TestResult {
  id             String   @id @default(cuid())
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id])
  level          String
  levelName      String
  totalScore     Int
  pct            Int
  skills         String
  weaknesses     String
  strengths      String
  recommendation String
  course         String   @default("pt")
  createdAt      DateTime @default(now())
}

/// An item the student missed, waiting to come back.
///
/// Leitner scheduling: `box` 1..5, each with a longer interval (lib/review.ts).
/// The question and answer are copied in so the review screen is one query and
/// does not depend on the curriculum file still having that item at that index.
/// Retired items are deleted, so the queue drains instead of growing.
model ReviewItem {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  moduleId  String
  unitIndex Int
  itemKey   String

  exerciseType String
  question     String
  expected     String

  box            Int       @default(1)
  dueAt          DateTime
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([studentId, moduleId, unitIndex, itemKey])
  @@index([studentId, dueAt])
}

/// One answered exercise item.
///
/// Only the FIRST answer per item is kept: the lesson reveals the correct
/// answer as soon as the student answers, so a second attempt reflects reading
/// the answer rather than knowing it. That also bounds growth to one row per
/// item per student.
model ExerciseAttempt {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  moduleId  String
  unitIndex Int
  /// Position of the item inside the unit, e.g. "c0-2" (core block 0, item 2)
  /// or "x1-3" (extra block 1, item 3). Matches the key used in the lesson UI.
  itemKey   String

  exerciseType String
  question     String
  answer       String
  expected     String
  correct      Boolean

  answeredAt DateTime @default(now())

  @@unique([studentId, moduleId, unitIndex, itemKey])
  @@index([studentId, correct])
}

model StudentLesson {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  moduleId    String
  unitIndex   Int
  completedAt DateTime @default(now())

  @@unique([studentId, moduleId, unitIndex])
}
