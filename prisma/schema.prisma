generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id        String   @id @default(cuid())
  name      String
  /// Null for students created by the placement test before self-signup existed.
  email     String?  @unique
  /// scrypt hash; null means this student has no account and reaches the course
  /// only through their /learn/<id> link.
  password  String?
  /// Chosen at signup. Students created by the test carry it on testResult
  /// instead, so read it with `student.course ?? student.testResult?.course`.
  course    String?
  /// Explicit newsletter consent, with the moment it was given.
  newsletter   Boolean   @default(false)
  newsletterAt DateTime?
  createdAt DateTime @default(now())

  testResult TestResult?
  lessons    StudentLesson[]
}

model TestResult {
  id             String   @id @default(cuid())
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id])
  level          String
  levelName      String
  totalScore     Int
  pct            Int
  skills         String
  weaknesses     String
  strengths      String
  recommendation String
  course         String   @default("pt")
  createdAt      DateTime @default(now())
}

model StudentLesson {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  moduleId    String
  unitIndex   Int
  completedAt DateTime @default(now())

  @@unique([studentId, moduleId, unitIndex])
}
