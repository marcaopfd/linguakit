generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id        String   @id @default(cuid())
  name      String
  /// Null for students created by the placement test before self-signup existed.
  email     String?  @unique
  /// scrypt hash; null means this student has no account and reaches the course
  /// only through their /learn/<id> link.
  password  String?
  /// Chosen at signup. Students created by the test carry it on testResult
  /// instead, so read it with `student.course ?? student.testResult?.course`.
  course    String?
  /// Which accent the course is spoken in, as a BCP-47 tag — "en-IE" for
  /// someone moving to Ireland. Null means the course default.
  accent    String?
  /// O código de recuperação, guardado só como hash scrypt — igual à senha.
  /// É o que devolve o acesso a quem esqueceu a senha enquanto não existe
  /// envio de e-mail. Nulo nas contas criadas antes de ele existir, e em
  /// quem já gastou o seu sem gerar outro.
  recoveryCode   String?
  /// Quando o código em vigor foi gerado. Serve para a tela dizer "gerado em
  /// tal dia" e para saber que o antigo não vale mais.
  recoveryCodeAt DateTime?

  /// Explicit newsletter consent, with the moment it was given.
  newsletter   Boolean   @default(false)
  newsletterAt DateTime?

  /// O plano: "free", "monthly" ou "annual". Quem nunca pagou fica em free,
  /// que é o padrão — nenhum aluno existente muda de comportamento.
  plan       String    @default("free")
  /// "active", "paused" ou "canceled". Pausar existe porque metade de quem
  /// assina este curso assina por causa de uma viagem que acaba.
  planStatus String    @default("active")
  /// Até quando o acesso pago vale. Nulo em quem nunca pagou.
  renewsAt   DateTime?
  /// O identificador da assinatura no provedor de pagamento, para o webhook
  /// achar o aluno quando o aviso chegar sem o e-mail.
  billingRef String?   @unique
  createdAt DateTime @default(now())

  testResult TestResult?
  lessons    StudentLesson[]
  attempts   ExerciseAttempt[]
  reviews    ReviewItem[]
  musicNotes MusicNote[]
  questions  Question[]
}

model TestResult {
  id             String   @id @default(cuid())
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id])
  level          String
  levelName      String
  totalScore     Int
  pct            Int
  skills         String
  weaknesses     String
  strengths      String
  recommendation String
  course         String   @default("pt")
  createdAt      DateTime @default(now())
}

/// An item the student missed, waiting to come back.
///
/// Leitner scheduling: `box` 1..5, each with a longer interval (lib/review.ts).
/// The question and answer are copied in so the review screen is one query and
/// does not depend on the curriculum file still having that item at that index.
/// Retired items are deleted, so the queue drains instead of growing.
model ReviewItem {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  moduleId  String
  unitIndex Int
  itemKey   String

  exerciseType String
  question     String
  expected     String

  box            Int       @default(1)
  dueAt          DateTime
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([studentId, moduleId, unitIndex, itemKey])
  @@index([studentId, dueAt])
}

/// One answered exercise item.
///
/// Only the FIRST answer per item is kept: the lesson reveals the correct
/// answer as soon as the student answers, so a second attempt reflects reading
/// the answer rather than knowing it. That also bounds growth to one row per
/// item per student.
model ExerciseAttempt {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  moduleId  String
  unitIndex Int
  /// Position of the item inside the unit, e.g. "c0-2" (core block 0, item 2)
  /// or "x1-3" (extra block 1, item 3). Matches the key used in the lesson UI.
  itemKey   String

  exerciseType String
  question     String
  answer       String
  expected     String
  correct      Boolean

  answeredAt DateTime @default(now())

  @@unique([studentId, moduleId, unitIndex, itemKey])
  @@index([studentId, correct])
}

/// Todo aviso de pagamento que a Kiwify mandou, tenha ele achado um aluno ou
/// não.
///
/// Antes disso, um aviso que não casava com nenhum e-mail virava um 200 e
/// sumia: quem comprasse o plano anual antes de criar a conta esperava um ano
/// até a renovação o encontrar, e quem pagasse com outro e-mail não aparecia
/// em lugar nenhum. Guardar o aviso resolve os dois — o cadastro procura por
/// um pagamento à espera, e o que sobra sem dono fica visível no painel em vez
/// de se perder.
///
/// Não tem chave estrangeira para Student de propósito: é o registro do que o
/// provedor disse, e precisa existir mesmo quando ainda não há aluno nenhum
/// com aquele e-mail. A exclusão de um aluno limpa os avisos dele pelo e-mail.
model PaymentNotice {
  id         String    @id @default(cuid())
  /// O e-mail da compra, normalizado como o do aluno.
  email      String
  /// "monthly" ou "annual".
  plan       String
  /// "active", "paused" ou "canceled".
  status     String
  renewsAt   DateTime?
  /// O id da assinatura na Kiwify.
  billingRef String?
  /// O evento como a Kiwify o nomeia, para quando algo não bater.
  event      String
  /// O aluno que este aviso encontrou. Nulo enquanto ninguém o reclamou.
  studentId  String?
  /// Quando foi aplicado. Nulo = esperando a conta aparecer.
  appliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([studentId])
}

model StudentLesson {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  moduleId    String
  unitIndex   Int
  completedAt DateTime @default(now())

  @@unique([studentId, moduleId, unitIndex])
}

/// O que o aluno escreveu nas tarefas de uma música.
///
/// Isto morava no localStorage, e a tela dizia isso com todas as letras —
/// prometer "salvo" sem ter onde salvar seria mentira na primeira troca de
/// aparelho. Agora que todo aluno tem conta, a redação da aula 5 é a única
/// coisa do curso que o aluno produz do zero, e era justamente a que se
/// perdia ao abrir o curso no notebook.
///
/// Cresce de forma limitada por construção: uma linha por tarefa de cada
/// música, garantida pela chave única — hoje no máximo duas por música.
/// `text` vazio não é apagado: a pessoa limpar o campo é um estado dela, não
/// um pedido de exclusão.
model MusicNote {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  /// O id do vídeo no YouTube, que é como lib/musicas identifica a música.
  videoId   String
  /// A posição da tarefa dentro da música, como a tela a numera.
  taskIndex Int
  /// A resposta, em texto livre. Limitada no servidor, não aqui.
  text      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, videoId, taskIndex])
  @@index([studentId])
}

/// Uma dúvida de aluno, e a resposta escrita à mão.
///
/// A ideia é que a resposta sirva duas vezes: para quem perguntou e para quem
/// tiver a mesma dúvida depois. Por isso a pergunta respondida vira página
/// pública — e é também a melhor prova que este produto pode dar de que
/// existe gente do outro lado, numa página de vendas que não tem depoimento
/// nenhum, de propósito.
///
/// Três decisões que moram neste modelo:
///
///   - `published` começa FALSO e só o professor liga. Conteúdo escrito por
///     terceiro que vai ao ar sozinho é spam no site que vende o produto, e
///     não existe como desfazer uma vez indexado.
///   - O NOME de quem perguntou nunca é publicado. Guardamos o studentId para
///     ele ver a resposta dele e para o professor saber com quem fala; a
///     página pública mostra só a pergunta e a resposta.
///   - A pergunta é guardada como a pessoa escreveu, e o professor pode
///     EDITAR o texto ao publicar (em `publishedText`): dúvida real costuma
///     vir com nome de rua, nome de empresa e coisa que a pessoa não queria
///     ver num site. Publicar o original sem revisão seria publicar dado
///     pessoal de alguém que só queria tirar uma dúvida.
model Question {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  /// O que a pessoa escreveu, como ela escreveu.
  text      String
  /// Onde ela estava quando perguntou — "trilha viagem, módulo 3", por
  /// exemplo. Ajuda o professor a responder no contexto certo.
  context   String?

  /// A versão limpa que vai ao ar. Nula = publicar o texto original.
  publishedText String?
  /// A resposta. Nula enquanto não foi respondida.
  answer    String?
  answeredAt DateTime?
  /// Só o professor liga. Enquanto for falso, a dúvida existe só para quem
  /// perguntou e para o painel.
  published Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([published, answeredAt])
}
